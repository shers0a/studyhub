@model List<AdminUserViewModel>
@{
    ViewData["Title"] = "Manage users";
}

<h1 class="h3 mb-3">Users</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Joined</th>
            <th>Role</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.DisplayName</td>
            <td>@user.Email</td>
            <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
            <td>
                @if (user.IsAdmin)
                {
                    <span class="badge bg-danger">Admin</span>
                }
                else
                {
                    <span class="badge bg-secondary">User</span>
                }
            </td>
            <td class="text-end">
                <form asp-action="ToggleAdmin" asp-route-id="@user.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        @(user.IsAdmin ? "Make user" : "Make admin")
                    </button>
                </form>
                <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this user permanently?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-outline-secondary">Back</a>
