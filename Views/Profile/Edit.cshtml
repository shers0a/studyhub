@model ProfileViewModel
@{
    ViewData["Title"] = "Edit profile";
}

<div class="card shadow-sm mx-auto" style="max-width: 640px;">
    <div class="card-body">
        <h2 class="h4 mb-3">Edit profile</h2>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3 text-center">
                @if (!string.IsNullOrEmpty(Model.CurrentAvatarUrl))
                {
                    <img src="@Model.CurrentAvatarUrl" alt="Current profile picture" class="rounded-circle"
                         style="width: 120px; height: 120px; object-fit: cover;" />
                }
            </div>

            <div class="mb-3">
                <label asp-for="AvatarFile" class="form-label"></label>
                <input asp-for="AvatarFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <span asp-validation-for="AvatarFile" class="text-danger"></span>
                <div class="form-text">JPG, PNG or WEBP, maximum 2 MB.</div>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StudyProgram" class="form-label"></label>
                <input asp-for="StudyProgram" class="form-control" />
                <span asp-validation-for="StudyProgram" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label"></label>
                <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
